<?xml version="1.0"?>
<package format="3">
  <name>fapp_planner</name>
  <version>2.0.0</version>
  <description>ROS 2 FAPP planner state machine.</description>
  <maintainer email="iszhouxin@zju.edu.cn">iszhouxin</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>obj_state_msgs</depend>
  <depend>path_searching</depend>
  <depend>plan_env</depend>
  <depend>quadrotor_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>traj_opt</depend>
  <depend>traj_utils</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
